# Stage 1: Build React/Vite SPA
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --prefer-offline || npm install

COPY . .

# Build production bundle with relative API routing for Nginx proxying
ENV VITE_API_BASE_URL=""
RUN npm run build

# Stage 2: Serve with Production Nginx
FROM nginx:1.25-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/oracle/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
